# Nova API PostgreSQL. Preencha apenas no arquivo privado .env.
NODE_ENV=production
HOST=127.0.0.1
PORT=3127
APP_ORIGIN=https://app.universodoproposito.com
TRUST_PROXY=loopback
DATABASE_URL=
INTERNAL_DATABASE_URL=
# Pelo menos 32 caracteres aleatorios por segredo.
AUTH_SECRET=
KIWIFY_WEBHOOK_SECRET=
# 32 bytes aleatorios em base64.
PAYLOAD_ENCRYPTION_KEY=
SMTP_PROVIDER=hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
DEV_MAILBOX=false
ALLOW_PREVIEW=false
AUTH_REQUESTS_PER_IP_HOUR=20
